From d724b85da47e7b808dfcb9300294a72b0cf889b9 Mon Sep 17 00:00:00 2001
From: Shaurya Patel <spatel27@cs.ubc.ca>
Date: Tue, 27 Oct 2026 11:39:29 -0700
Subject: [PATCH 1/2] mm/swap: pluggable swap-in prefetcher hook

A module can register a predict() callback (register_swap_prefetcher()).
On each swap-in fault, swapin_readahead() asks it which pages around the
fault to read in as well - two 64-bit masks, +1..+64 and -1..-64 pages -
and queues the faulting page's read and all requested reads together under
one plug, using the same per-page steps as swap_vma_readahead(). Requested
pages outside the faulting VMA or page table, or not swapped out, are
skipped. With nothing registered, or predict() returning false, the
kernel's own read-ahead runs unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 include/linux/swap_prefetch.h |  38 +++++++++++
 mm/swap_state.c               | 120 ++++++++++++++++++++++++++++++++++
 2 files changed, 158 insertions(+)
 create mode 100644 include/linux/swap_prefetch.h

diff --git a/include/linux/swap_prefetch.h b/include/linux/swap_prefetch.h
new file mode 100644
index 000000000..27afd0979
--- /dev/null
+++ b/include/linux/swap_prefetch.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SWAP_PREFETCH_H
+#define _LINUX_SWAP_PREFETCH_H
+
+/*
+ * Pluggable swap-in prefetcher. A module registers a predict() callback;
+ * swapin_readahead() then asks it, on every swap-in fault, which pages near
+ * the faulting one to read in along with it, and issues all of those reads
+ * together with the faulting page's (asynchronously, like the built-in
+ * read-ahead). With no prefetcher registered, or when predict() returns
+ * false for a fault, the kernel's own read-ahead runs unchanged.
+ */
+
+#include <linux/types.h>
+
+struct vm_fault;
+
+struct swap_prefetch_req {
+	u64 fwd;	/* bit k set: also read the page k + 1 pages after the fault  (+1 .. +64) */
+	u64 back;	/* bit k set: also read the page k + 1 pages before the fault (-1 .. -64) */
+};
+
+struct swap_prefetch_ops {
+	/*
+	 * Called under rcu_read_lock() on each swap-in fault, before any read
+	 * is issued; must not sleep. Fill @req and return true to handle this
+	 * fault (an empty @req means "read only the faulting page"), or return
+	 * false to fall back to the kernel's read-ahead for it. A requested
+	 * page is only read if it lies in the faulting VMA and the same page
+	 * table (2MB-aligned range) as the fault, and is currently swapped out.
+	 */
+	bool (*predict)(struct vm_fault *vmf, struct swap_prefetch_req *req);
+};
+
+int register_swap_prefetcher(const struct swap_prefetch_ops *ops);
+void unregister_swap_prefetcher(const struct swap_prefetch_ops *ops);
+
+#endif /* _LINUX_SWAP_PREFETCH_H */
diff --git a/mm/swap_state.c b/mm/swap_state.c
index b3b14bd0d..a64ec2d5a 100644
--- a/mm/swap_state.c
+++ b/mm/swap_state.c
@@ -21,6 +21,7 @@
 #include <linux/swap_slots.h>
 #include <linux/huge_mm.h>
 #include <linux/shmem_fs.h>
+#include <linux/swap_prefetch.h>
 #include "internal.h"
 #include "swap.h"
 
@@ -838,6 +839,113 @@ static struct page *swap_vma_readahead(swp_entry_t fentry, gfp_t gfp_mask,
 				     NULL);
 }
 
+/*
+ * Pluggable swap-in prefetcher - see include/linux/swap_prefetch.h. At most
+ * one is registered at a time; predict() runs under rcu_read_lock(), and
+ * unregistering waits for any call in flight before the module can go away.
+ */
+static const struct swap_prefetch_ops __rcu *swap_prefetcher;
+static DEFINE_MUTEX(swap_prefetcher_lock);
+
+int register_swap_prefetcher(const struct swap_prefetch_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->predict)
+		return -EINVAL;
+	mutex_lock(&swap_prefetcher_lock);
+	if (rcu_access_pointer(swap_prefetcher))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(swap_prefetcher, ops);
+	mutex_unlock(&swap_prefetcher_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(register_swap_prefetcher);
+
+void unregister_swap_prefetcher(const struct swap_prefetch_ops *ops)
+{
+	mutex_lock(&swap_prefetcher_lock);
+	if (rcu_access_pointer(swap_prefetcher) == ops)
+		RCU_INIT_POINTER(swap_prefetcher, NULL);
+	mutex_unlock(&swap_prefetcher_lock);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(unregister_swap_prefetcher);
+
+/* Queue the read of one page the prefetcher asked for, if it lies in the
+ * faulting VMA and page table and is swapped out - the same per-page steps
+ * as swap_vma_readahead(). */
+static void swap_pf_read_one(struct vm_fault *vmf, unsigned long addr,
+			     gfp_t gfp_mask, struct swap_iocb **splug)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	pte_t *pte, pentry;
+	swp_entry_t entry;
+	struct page *page;
+	bool page_allocated;
+
+	/* unsigned: an address below 0 wraps above vm_end and is rejected */
+	if (addr < vma->vm_start || addr >= vma->vm_end ||
+	    (addr & PMD_MASK) != (vmf->address & PMD_MASK))
+		return;
+	pte = pte_offset_map(vmf->pmd, addr);
+	if (!pte)
+		return;
+	pentry = ptep_get_lockless(pte);
+	pte_unmap(pte);
+	if (!is_swap_pte(pentry))
+		return;
+	entry = pte_to_swp_entry(pentry);
+	if (unlikely(non_swap_entry(entry)))
+		return;
+	page = __read_swap_cache_async(entry, gfp_mask, vma, addr,
+				       &page_allocated);
+	if (!page)
+		return;
+	if (page_allocated) {
+		swap_readpage(page, false, splug);
+		SetPageReadahead(page);
+		count_vm_event(SWAP_RA);
+	}
+	put_page(page);
+}
+
+/* Read the faulting page plus every page the prefetcher asked for, all
+ * queued together under one plug so they go out in parallel. */
+static struct page *swap_pf_readahead(swp_entry_t fentry, gfp_t gfp_mask,
+				      struct vm_fault *vmf,
+				      const struct swap_prefetch_req *req)
+{
+	struct blk_plug plug;
+	struct swap_iocb *splug = NULL;
+	struct page *page;
+	bool page_allocated;
+	u64 bits;
+
+	blk_start_plug(&plug);
+	/* the faulting page's own read goes first */
+	page = __read_swap_cache_async(fentry, gfp_mask, vmf->vma,
+				       vmf->address, &page_allocated);
+	if (page) {
+		if (page_allocated)
+			swap_readpage(page, false, &splug);
+		put_page(page);
+	}
+	for (bits = req->fwd; bits; bits &= bits - 1)
+		swap_pf_read_one(vmf, vmf->address +
+				 (__ffs64(bits) + 1) * PAGE_SIZE, gfp_mask, &splug);
+	for (bits = req->back; bits; bits &= bits - 1)
+		swap_pf_read_one(vmf, vmf->address -
+				 (__ffs64(bits) + 1) * PAGE_SIZE, gfp_mask, &splug);
+	blk_finish_plug(&plug);
+	swap_read_unplug(splug);
+	lru_add_drain();
+	/* already in the swap cache (or being read) from above */
+	return read_swap_cache_async(fentry, gfp_mask, vmf->vma, vmf->address,
+				     NULL);
+}
+
 /**
  * swapin_readahead - swap in pages in hope we need them soon
  * @entry: swap entry of this memory
@@ -853,6 +961,18 @@ static struct page *swap_vma_readahead(swp_entry_t fentry, gfp_t gfp_mask,
 struct page *swapin_readahead(swp_entry_t entry, gfp_t gfp_mask,
 				struct vm_fault *vmf)
 {
+	const struct swap_prefetch_ops *ops;
+	struct swap_prefetch_req req = { 0, 0 };
+	bool handled = false;
+
+	rcu_read_lock();
+	ops = rcu_dereference(swap_prefetcher);
+	if (ops)
+		handled = ops->predict(vmf, &req);
+	rcu_read_unlock();
+	if (handled)
+		return swap_pf_readahead(entry, gfp_mask, vmf, &req);
+
 	return swap_use_vma_readahead() ?
 			swap_vma_readahead(entry, gfp_mask, vmf) :
 			swap_cluster_readahead(entry, gfp_mask, vmf);
-- 
